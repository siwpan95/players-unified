# ===== players-unified 根 .gitignore =====
# 各子项目自带 .gitignore，本文件兜住跨子项目通用的构建产物/运行时产物，
# 防止误提交。源码、脚本、文档、配置均不被忽略。

# --- 通用构建/分发产物 ---
build/
dist/
release/
bin/
obj/
out/
target/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Node / JS ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- 日志 / 运行时状态 ---
logs/
*.log
.state/

# --- 编辑器 / OS ---
.vscode/
.idea/
*.swb
Thumbs.db
.DS_Store

# --- 本仓库整合时显式排除的重内容（见 ARCHITECTURE.md §0） ---
# localplayer 个人媒体库（数百 GB .ts/.mp4）
localplayer/media/
localplayer/.archived/
# pluginplayer 第三方依赖与压缩包（可经 tools/fetch_deps.py 重新拉取）
pluginplayer/vendor/
pluginplayer/_deps/
pluginplayer/_extract/
pluginplayer/player/
pluginplayer/_vendor_backup_20260912/
pluginplayer/_dist_baseline_backup/
pluginplayer/Smiley Sans.zip
