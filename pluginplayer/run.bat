@echo off
rem PluginPlayer launcher: drag a media file onto this file to play it.
rem GENERATED by build.py (make_launcher) -- edit the generator, not this file.
setlocal
set "PP_ROOT=%~dp0"
set "PP_EXE=%PP_ROOT%dist\pluginplayer.exe"
if not exist "%PP_EXE%" (
  echo [ERR] not found: %PP_EXE%
  echo       build it first: F:\Python314\python.exe build.py
  pause
  exit /b 1
)
rem Arguments stay as the caller wrote them: Explorer already quotes a
rem dragged path that contains a space, and %* preserves that quoting.
cd /d "%PP_ROOT%dist"
"%PP_EXE%" %*
set "PP_RC=%ERRORLEVEL%"
if not "%PP_RC%"=="0" (
  echo.
  echo [ERR] pluginplayer.exe exit code %PP_RC%
  pause
)
exit /b %PP_RC%
