@echo off
rem PP_CLI_SHIM v1 - generated by tools/pp_cli.py install-cli; safe to delete.
rem PluginPlayer command-line interface shim.
setlocal
set "PP_ROOT=%~dp0"
set "PP_PY=%~dp0.venv\Scripts\python.exe"
set "PP_PYARG="
if defined PP_PYTHON set "PP_PY=%PP_PYTHON%"
if defined PP_PY if not exist "%PP_PY%" set "PP_PY="
if defined PP_PY goto pp_run
if exist "%~dp0.venv\Scripts\python.exe" set "PP_PY=%~dp0.venv\Scripts\python.exe"
if defined PP_PY goto pp_run
where py >nul 2>nul
if not errorlevel 1 set "PP_PY=py"
if defined PP_PY goto pp_run
where python >nul 2>nul
if not errorlevel 1 set "PP_PY=python"
if not defined PP_PY (
  echo [ERR] Python not found. Set PP_PYTHON to a python.exe path. 1>&2
  exit /b 6
)
:pp_run
if /i "%PP_PY%"=="py" set "PP_PYARG=-3"
"%PP_PY%" %PP_PYARG% "%PP_ROOT%tools\pp_cli.py" %*
set "PP_RC=%ERRORLEVEL%"
exit /b %PP_RC%
