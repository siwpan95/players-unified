@echo off
rem PluginPlayer launcher -- starts THIS project.
rem Delegates to run.bat so the start logic exists exactly once
rem (quoting / artifact check / exit code: docs/DEVELOPMENT.md section 7).
rem Console code page: the player prints UTF-8 (source and compiler exec charset
rem are both UTF-8) while a fresh console defaults to GBK here, which garbles
rem Chinese output. The program itself also calls SetConsoleOutputCP; this line
rem covers the shell around it, so a double-click always reads cleanly.
rem Double-click to open the player; drop a media file on it to play that file.
rem GENERATED by build.py (make_launcher) -- edit the generator, not this file.
setlocal
chcp 65001 >nul
if not exist "%~dp0run.bat" (
  echo [ERR] run.bat is missing next to this launcher.
  pause
  exit /b 1
)
call "%~dp0run.bat" %*
exit /b %ERRORLEVEL%
